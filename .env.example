# =====================================================================
# Radar Legislativo — modelo de configuração
# Copie para .env (que NUNCA vai para o Git) e preencha os valores reais.
# Especificação: docs/especificacao/03_Radar_Legislativo_V3.spec, seção 3.1.
# Comentários ficam em linhas próprias (compatível com dotenv e docker compose).
# =====================================================================

# --- Bancos (Supabase self-hosted na VPS, banco dedicado do projeto) ---
# Máquina de desenvolvimento, pelo túnel SSH (make tunnel) até o pg-gateway:
DATABASE_URL=postgresql+psycopg://radar_app:<senha>@localhost:5433/radar_legislativo
# Serviços do Swarm na VPS usam o gateway interno:
#   postgresql+psycopg://radar_app:<senha>@172.18.0.1:5433/radar_legislativo
# Vazio = usa DATABASE_URL
BRONZE_DATABASE_URL=
DATABASE_URL_READONLY=postgresql+psycopg://radar_leitura:<senha>@localhost:5433/radar_legislativo
# Orçamento de espaço do projeto em MB (alerta em 80%)
DB_LIMITE_MB=10240

# --- VPS / túnel SSH (a autenticação é pela chave SSH; aqui só nomes e portas) ---
VPS_SSH=vps-portfolio
# Destino do túnel visto de dentro da VPS (pg-gateway)
VPS_DB_DESTINO=127.0.0.1:5433
TUNNEL_PORTA_LOCAL=5433

# --- API Câmara ---
CAMARA_BASE_URL=https://dadosabertos.camara.leg.br/api/v2
CAMARA_OPENAPI_URL=https://dadosabertos.camara.leg.br/api/v2/api-docs
CAMARA_ITENS_POR_PAGINA=100
CAMARA_THROTTLE_SEGUNDOS=0.2
CAMARA_TIMEOUT_CONNECT=5
CAMARA_TIMEOUT_READ=60
CAMARA_MAX_RETRIES=5
CAMARA_USER_AGENT=radar-legislativo/2.0 (projeto academico)
ID_LEGISLATURA=57
INICIO_LEGISLATURA=2023-02-01

# --- Pipeline ---
LANDING_DIR=data/landing
REJECTED_DIR=data/rejected
LOG_DIR=data/logs
EXTRACAO_WORKERS=4
JANELA_INCREMENTAL_DIAS=2
DESPESAS_MESES_REPROCESSAR=3
# 0 = mantém todas as versões da Bronze
BRONZE_RETENCAO_VERSOES_DIAS=0
TIPOS_RELEVANTES=PL,PLP,PEC,MPV,PDL
# Partições da Landing mais antigas que isso são compactadas em .tar.gz
LANDING_COMPACTAR_APOS_DIAS=7

# --- OpenAI ---
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BATCH=100
# Confirmar o modelo pequeno vigente em platform.openai.com
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=300
IA_RESUMO_HABILITADO=true
IA_ORCAMENTO_MAX_USD=1.00
# Preços por 1 milhão de tokens — confirmar em platform.openai.com/pricing
PRECO_EMBEDDING_USD_1M=0.02
PRECO_LLM_ENTRADA_USD_1M=0.15
PRECO_LLM_SAIDA_USD_1M=0.60
TEMA_LIMIAR_MINIMO=0.20

# --- Telegram (alertas, M6) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboards ---
DASHBOARD_OUT_DIR=site
DASHBOARD_BASE_URL=https://<usuario>.github.io/radar-legislativo/
DASHBOARD_JANELA_DIAS=90
# Publicação: push do site para o branch gh-pages com deploy key de escrita (só na VPS)
GH_PAGES_REMOTE=git@github.com:<usuario>/radar-legislativo.git
GH_PAGES_BRANCH=gh-pages
GH_DEPLOY_KEY_PATH=/run/secrets/gh_deploy_key

# --- Runner / n8n ---
# O n8n é o já existente na VPS (decisão D3): sua chave de criptografia não fica aqui.
RUNNER_TOKEN=troque-por-um-token-aleatorio
GENERIC_TIMEZONE=America/Sao_Paulo

# --- Logging ---
LOG_LEVEL=INFO
