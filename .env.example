# =====================================================================
# Radar Legislativo — modelo de configuração
# Copie para .env (que NUNCA vai para o Git) e preencha os valores reais.
# Comentários ficam em linhas próprias (compatível com dotenv e docker compose).
# =====================================================================

# --- Bancos ---
# Supabase > Project Settings > Database > Connection string (pooler, porta 6543)
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Vazio = usa DATABASE_URL (preencha só se a Bronze for para outro PostgreSQL)
BRONZE_DATABASE_URL=
DATABASE_URL_READONLY=postgresql+psycopg://dashboard_leitura.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DB_LIMITE_MB=500

# --- API Câmara ---
CAMARA_BASE_URL=https://dadosabertos.camara.leg.br/api/v2
CAMARA_OPENAPI_URL=https://dadosabertos.camara.leg.br/api/v2/api-docs
CAMARA_ITENS_POR_PAGINA=100
CAMARA_THROTTLE_SEGUNDOS=0.2
CAMARA_TIMEOUT_CONNECT=5
CAMARA_TIMEOUT_READ=60
CAMARA_MAX_RETRIES=5
CAMARA_USER_AGENT=radar-legislativo/2.0 (projeto academico)
ID_LEGISLATURA=57
INICIO_LEGISLATURA=2023-02-01

# --- Pipeline ---
LANDING_DIR=data/landing
REJECTED_DIR=data/rejected
LOG_DIR=data/logs
EXTRACAO_WORKERS=4
JANELA_INCREMENTAL_DIAS=2
DESPESAS_MESES_REPROCESSAR=3
# 0 = mantém todas as versões da Bronze
BRONZE_RETENCAO_VERSOES_DIAS=0
TIPOS_RELEVANTES=PL,PLP,PEC,MPV,PDL

# --- OpenAI ---
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BATCH=100
# Confirmar o modelo pequeno vigente em platform.openai.com
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=300
IA_RESUMO_HABILITADO=true
IA_ORCAMENTO_MAX_USD=1.00
# Preços por 1 milhão de tokens — confirmar em platform.openai.com/pricing
PRECO_EMBEDDING_USD_1M=0.02
PRECO_LLM_ENTRADA_USD_1M=0.15
PRECO_LLM_SAIDA_USD_1M=0.60
TEMA_LIMIAR_MINIMO=0.20

# --- Telegram (alertas, M6) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboards ---
DASHBOARD_OUT_DIR=site
DASHBOARD_BASE_URL=https://<usuario>.github.io/radar-legislativo/
DASHBOARD_JANELA_DIAS=90

# --- Runner / n8n ---
RUNNER_TOKEN=troque-por-um-token-aleatorio
N8N_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria
GENERIC_TIMEZONE=America/Sao_Paulo

# --- Logging ---
LOG_LEVEL=INFO
