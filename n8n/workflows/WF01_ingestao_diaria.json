      "position": [
        240,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Radar Runner Token"
        }
      }
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "minutes"
      },
      "id": "3567bf4e-ff13-5b73-9926-1f0d196bf0d3",
      "name": "Espera 5 min",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        480,
        100
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://radar_runner:8000/jobs/{{ $('Inicia carga').item.json.job }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "id": "93d84f25-12ec-5601-9267-82c939201b82",
