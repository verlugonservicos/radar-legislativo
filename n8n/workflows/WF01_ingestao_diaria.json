      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://radar_runner:8000/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"mode\": \"incremental\", \"orcamento\": 0.15}"
      },
      "id": "43e36c4e-a2d4-56c4-b849-db5582c775f8",
      "name": "Inicia carga",
