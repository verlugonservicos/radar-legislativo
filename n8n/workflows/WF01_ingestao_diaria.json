      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Radar Runner Token"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "4593570e-647a-5455-a2a5-d38d4f16ebd9",
              "leftValue": "={{ $json.concluido }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0d43c5a1-a51c-51ff-8641-2db3100c0992",
      "name": "Terminou?",
