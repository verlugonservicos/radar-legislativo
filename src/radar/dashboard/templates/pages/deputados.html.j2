{% extends "base.html.j2" %}
{% from "partials/componentes.html.j2" import card, grafico %}
{% block conteudo %}
<div class="filters" role="group" aria-label="Filtros de deputados">
  <label class="filters__label" for="f-partido">Partido</label><select class="select" id="f-partido"><option value="">Todos</option></select>
  <label class="filters__label" for="f-uf">UF</label><select class="select" id="f-uf"><option value="">Todas</option></select>
  <label class="filters__label" for="f-metrica">Mapa</label>
  <select class="select" id="f-metrica">
    <option value="score_atividade_medio">Score de atividade médio</option>
    <option value="gasto_por_deputado">Gasto por deputado</option>
    <option value="presenca_votacoes_media">Presença média em votações</option>
    <option value="deputados">Número de deputados</option>
  </select>
</div>
<div class="grid">
  <section class="card span-6" aria-labelledby="mapa-t">
    <header class="card__head">
      <div><h2 class="card__title" id="mapa-t">Brasil por UF ou região</h2><p class="card__sub">Métrica selecionada acima · no modo UF, clique num estado para filtrar</p></div>
      <div class="card__actions">
        <div class="seg" role="group" aria-label="Agrupar o mapa" id="mapa-agrupamento">
          <button type="button" data-modo="uf" aria-pressed="true">Por UF</button>
          <button type="button" data-modo="regiao" aria-pressed="false">Por região</button>
        </div>
      </div>
    </header>
    {{ grafico("graf-mapa", "Mapa do Brasil por unidade da federação ou região", "chart--mapa") }}
  </section>
  {% call card("ranking", "Top 20 por score de atividade", "Média dos percentis de autorias, presença, eventos e discursos (0–100)", "span-6", termo="score-atividade") %}{{ grafico("graf-ranking", "Ranking dos 20 deputados mais ativos", "chart--ranking") }}{% endcall %}
  {% call card("gasto-partido", "Gasto da cota por partido", "Valor líquido dos deputados em exercício no período carregado · respeita os filtros acima", "span-6", termo="cota") %}{{ grafico("graf-gasto-partido", "Barras do gasto da cota parlamentar por partido", "chart--ranking") }}{% endcall %}
  {% call card("gasto-deputado", "Top 20 deputados por gasto da cota", "Valor líquido no período carregado · respeita os filtros acima", "span-6", termo="cota") %}{{ grafico("graf-gasto-deputado", "Barras dos 20 deputados com maior gasto da cota", "chart--ranking") }}{% endcall %}
  {% call card("tabela", "Deputados em exercício", "Clique para ver o perfil", "span-12") %}<div id="tabela-deputados"></div>{% endcall %}
</div>
{% endblock %}
