{% extends "base.html.j2" %}
{% from "partials/componentes.html.j2" import card, grafico %}
{% block conteudo %}
<div class="filters" role="group" aria-label="Filtro de temas">
  <span class="filters__label">Temas:</span>
  <div id="filtro-temas" class="filters" style="margin:0"></div>
  <button class="btn" type="button" id="limpar-temas">Limpar</button>
</div>
<div class="grid">
  {% call card("area", "Proposições relevantes por tema e semana", "Janela do painel · S-NN = número da semana no ano", "span-8", termo="tema-ia") %}{{ grafico("graf-area", "Área empilhada de proposições por tema e semana", "chart--lg") }}{% endcall %}
  {% call card("acuracia", "Acurácia da classificação por IA", "Contra os temas oficiais da Câmara", "span-4", termo="acuracia") %}
    {{ grafico("graf-gauge", "Acurácia da IA", "chart--sm") }}
    <dl class="kv" id="kv-ia"></dl>
  {% endcall %}
  {% call card("treemap", "Tema → tipo de proposição", "Janela do painel", "span-6") %}{{ grafico("graf-treemap", "Treemap de temas e tipos de proposição") }}{% endcall %}
  {% call card("tramitacao", "Tempo de tramitação por tema", "Mediana e percentil 90, em dias", "span-6", termo="tramitacao-dias") %}{{ grafico("graf-tramitacao", "Barras de mediana de dias de tramitação por tema") }}{% endcall %}
  <section class="card span-6" aria-labelledby="projetos-t">
    <header class="card__head">
      <div><h2 class="card__title" id="projetos-t">Projetos apresentados por partido</h2><p class="card__sub" id="projetos-sub">Janela do painel · só o autor principal (1º signatário) · PL, PLP, PEC e PDL · deputados em exercício<span id="projetos-sub-media" hidden> · média = projetos ÷ deputados do partido</span></p></div>
      <div class="card__actions">
        <div class="seg" role="group" aria-label="Medida dos projetos" id="projetos-modo">
          <button type="button" data-modo="total" aria-pressed="true">Total</button>
          <button type="button" data-modo="por-deputado" aria-pressed="false">Média por deputado</button>
        </div>
        <a class="btn" href="glossario.html#proposicao" title="Ver no glossário">O que é?<span class="sr-only"> Projetos apresentados no glossário</span></a>
      </div>
    </header>
    {{ grafico("graf-projetos", "Barras de projetos apresentados por partido", "chart--ranking") }}
  </section>
  {% call card("setores", "Setores econômicos citados pela IA", "Menções nos resumos executivos (um resumo cita até 4 setores)", "span-6", termo="resumo") %}{{ grafico("graf-setores", "Barras de setores mais citados", "chart--ranking chart--estica") }}{% endcall %}
  {% call card("tabela", "Proposições relevantes recentes", "Apresentadas na janela do painel · clique para ver o detalhe", "span-12") %}<div id="tabela-proposicoes"></div>{% endcall %}
</div>
{% endblock %}
