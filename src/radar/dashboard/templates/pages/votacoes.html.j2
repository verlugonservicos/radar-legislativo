{% extends "base.html.j2" %}
{% from "partials/componentes.html.j2" import card, grafico %}
{% block conteudo %}
<div class="grid">
  {% call card("dia", "Votações por dia", "Aprovadas × rejeitadas · últimos 90 dias", "span-7") %}{{ grafico("graf-dia", "Barras empilhadas de votações aprovadas e rejeitadas por dia") }}{% endcall %}
  {% call card("participacao", "Participação por partido", "Presença média dos deputados em exercício nas votações nominais do Plenário", "span-5") %}{{ grafico("graf-participacao", "Barras de participação por partido", "chart--lg") }}{% endcall %}
  {% call card("dispersao", "Fidelidade × governismo", "Cada bolha é um partido; o tamanho é o número de deputados", "span-6") %}{{ grafico("graf-dispersao", "Dispersão de fidelidade partidária e governismo por partido", "chart--lg") }}{% endcall %}
  {% call card("heatmap", "Concordância entre partidos", "Voto majoritário (Sim/Não) de cada partido nas mesmas votações · partidos com 5+ deputados", "span-6") %}{{ grafico("graf-heatmap", "Mapa de calor de concordância entre partidos", "chart--lg") }}{% endcall %}
  {% call card("tabela", "Indicadores por partido", "Deputados em exercício", "span-12") %}<div id="tabela-partidos"></div>{% endcall %}
</div>
{% endblock %}
