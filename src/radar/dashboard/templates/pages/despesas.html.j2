{% extends "base.html.j2" %}
{% from "partials/componentes.html.j2" import card, grafico %}
{% block conteudo %}
<div class="grid">
  {% call card("mensal", "Gasto mensal da cota parlamentar", "Valor líquido por mês de emissão da nota (meses carregados; notas recentes chegam com atraso)", "span-8", termo="cota") %}{{ grafico("graf-mensal", "Linha do gasto mensal da cota") }}{% endcall %}
  {% call card("quarentena", "Quarentena de qualidade", "Lançamentos com valor do documento negativo (estornos) ficam fora dos totais", "span-4", termo="quarentena") %}<dl class="kv" id="kv-quarentena"></dl><p class="muted" style="font-size:var(--fs-xs);margin-top:var(--space-4)">Além disso, o sinal do valor líquido vem invertido na API em parte dos lançamentos; a Silver corrige quando o módulo bate com documento − glosa (ADR-024).</p>{% endcall %}
  {% call card("tipos", "Gasto por tipo de despesa (Top 12)", "Valor líquido no período", "span-6") %}{{ grafico("graf-tipos", "Barras de gasto por tipo de despesa", "chart--lg") }}{% endcall %}
  {% call card("fornecedores", "Fornecedores (Top 15)", "Pessoas jurídicas (CNPJ)", "span-6") %}{{ grafico("graf-fornecedores", "Barras dos 15 maiores fornecedores", "chart--lg") }}{% endcall %}
  {% call card("partido", "Gasto por deputado, por partido", "Valor líquido ÷ deputados em exercício · (%) = diferença para a média nacional (linha tracejada)", "span-6", termo="gasto-deputado") %}{{ grafico("graf-partido", "Barras de gasto por deputado em cada partido", "chart--ranking") }}{% endcall %}
  {% call card("uf", "Gasto por deputado, por UF", "Valor líquido ÷ deputados em exercício · (%) = diferença para a média nacional (linha tracejada)", "span-6", termo="gasto-deputado") %}{{ grafico("graf-uf", "Barras de gasto por deputado em cada UF", "chart--ranking chart--estica") }}{% endcall %}
  {% call card("outliers", "Gastos fora da curva", "Deputado × tipo de despesa com z-score acima de 2 dentro do tipo", "span-12", termo="outlier") %}<div id="tabela-outliers"></div>{% endcall %}
</div>
{% endblock %}
