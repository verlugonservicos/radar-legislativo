{% from "partials/icones.html.j2" import icone %}
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pagina.titulo }} · {{ cfg.titulo }}</title>
  <meta name="description" content="{{ pagina.descricao }}">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#4F46E5">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%234F46E5'/%3E%3Ccircle cx='16' cy='16' r='9' fill='none' stroke='white' stroke-width='2.5'/%3E%3Ccircle cx='16' cy='16' r='2.5' fill='white'/%3E%3C/svg%3E">
  <script>
    /* aplica o tema salvo antes de pintar (evita piscar) */
    try { const t = localStorage.getItem('radar-tema'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="stylesheet" href="{{ asset('css/tokens.css') }}">
  <link rel="stylesheet" href="{{ asset('css/layout.css') }}">
  <link rel="stylesheet" href="{{ asset('css/components.css') }}">
</head>
<body>
<a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
<div class="app">
  <aside class="sidebar" aria-label="Navegação principal">
    <a class="brand" href="index.html">
      <span class="brand__logo">{{ icone("radar") }}</span>
      <span class="brand__text"><span class="brand__name">{{ cfg.titulo }}</span><span class="brand__sub">{{ cfg.subtitulo }}</span></span>
    </a>
    <nav class="nav">
      {% for p in cfg.paginas %}
      <a href="{{ p.slug }}.html" {% if p.slug == pagina.slug %}aria-current="page"{% endif %} title="{{ p.titulo }}">{{ icone(p.icone) }}<span>{{ p.titulo }}</span></a>
      {% endfor %}
    </nav>
    <div class="sidebar__foot">
      <p>Cobertura da API: <strong data-meta="cobertura">78/78</strong> endpoints</p>
      <p><a href="{{ cfg.repositorio }}" rel="noopener">Código no GitHub</a></p>
    </div>
  </aside>
  <div class="scrim" aria-hidden="true"></div>
  <div class="main">
    <header class="header">
      <button class="icon-btn menu-btn" type="button" data-action="menu" aria-label="Abrir menu" aria-expanded="false">{{ icone("menu") }}</button>
      <button class="icon-btn collapse-btn" type="button" data-action="recolher" aria-label="Recolher menu lateral" aria-expanded="true">{{ icone("panel-left") }}</button>
      <h1 class="header__title">{{ pagina.titulo }}</h1>
      <div class="header__actions">
        <span class="update-badge" data-update><span class="update-badge__dot" aria-hidden="true"></span><span data-update-text>Carregando…</span></span>
        <button class="icon-btn" type="button" data-action="tema" aria-label="Alternar tema" aria-pressed="false">
          <span class="ico-sun">{{ icone("sun") }}</span>
        </button>
      </div>
    </header>
    <main class="content" id="conteudo" tabindex="-1">
      <p class="page-intro">{{ pagina.descricao }}</p>
      {% block conteudo %}{% endblock %}
    </main>
    <footer class="footer">
      Fonte: {{ cfg.fonte }} · período <span data-meta="periodo">—</span> · atualizado em <span data-meta="atualizado">—</span> ·
      {{ cfg.titulo }} para {{ cfg.subtitulo }} · {{ ano }}
    </footer>
  </div>
</div>
<script src="{{ echarts.src }}" integrity="{{ echarts.integrity }}" crossorigin="anonymous" defer></script>
<script type="module" src="{{ asset('js/pages/' ~ pagina.slug ~ '.js') }}"></script>
</body>
</html>
